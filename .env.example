# Copia este archivo como .env y llena los valores.
# Genera la SECRET_KEY con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=gestor_academico
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# URL del frontend (para los enlaces de recuperar contraseña)
FRONTEND_URL=http://localhost:5173

# Correo: en desarrollo el correo se imprime en la terminal de Django.
# Solo si pones ENVIAR_CORREOS_REALES=True hacen falta las variables EMAIL_*
ENVIAR_CORREOS_REALES=False
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=

# Solo para producción (DEBUG=False)
# CORS_ALLOWED_ORIGINS=
# REDIS_URL=

# Opcional: cambia la ruta del admin (por defecto admin/)
# ADMIN_URL=admin/